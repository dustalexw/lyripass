{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "copyright": "Based on LRCGET \u00a9 Thang Tran and contributors. MIT license.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/linux/lrcget.desktop",
        "files": {
          "/usr/share/metainfo/app.lyripass.desktop.metainfo.xml": "../packaging/linux/lrcget.metainfo.xml"
        },
        "depends": []
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/app.lyripass.desktop.metainfo.xml": "../packaging/linux/lrcget.metainfo.xml"
        },
        "bundleMediaFramework": false
      },
      "rpm": {
        "desktopTemplate": "../packaging/linux/lrcget.desktop",
        "files": {
          "/usr/share/metainfo/app.lyripass.desktop.metainfo.xml": "../packaging/linux/lrcget.metainfo.xml"
        },
        "depends": []
      }
    },
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "-"
    },
    "resources": [],
    "shortDescription": "Your music library, with every word in time.",
    "targets": "all"
  },
  "productName": "Lyripass",
  "mainBinaryName": "lyripass",
  "identifier": "app.lyripass.desktop",
  "plugins": {},
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "fullscreen": false,
        "minWidth": 1024,
        "minHeight": 700,
        "width": 1280,
        "height": 840,
        "resizable": true,
        "title": "Lyripass",
        "decorations": true,
        "transparent": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": [
          "**"
        ],
        "enable": true
      },
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost; media-src *; connect-src ipc: http://ipc.localhost 'self' asset: *; style-src 'unsafe-inline' 'self'"
    }
  },
  "version": "0.1.0"
}
